# Copy to wrangler.toml and enter the existing D1 database ID.
# Keep secrets in the Cloudflare Pages dashboard.
name = "sharethecost"
pages_build_output_dir = "./dist"
compatibility_date = "2026-11-13"

[vars]
TURNSTILE_SITE_KEY = "0x4AAAAAAGCqOqqHA_HUm7DD"

[[d1_databases]]
binding = "DB"
database_name = "sharethecost"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"
migrations_dir = "migrations"
